{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "dependsOn": ["^build", "^proto:gen"],
            "inputs": ["src/**", "tsconfig.json", "vite.config.ts"],
            "outputs": ["dist/**"]
        },
        "dev": {
            "persistent": true
        },
        "lint": {
            "inputs": ["src/**"]
        },
        "format": {
            "inputs": ["src/**"]
        },
        "test": {
            "dependsOn": ["^proto:gen"],
            "inputs": ["src/**", "vitest.config.ts"]
        },
        "typecheck": {
            "dependsOn": ["^proto:gen"],
            "inputs": ["src/**", "tsconfig.json"]
        },
        "proto:gen": {
            "inputs": ["proto/**"],
            "outputs": ["src/generated/**"]
        }
    },
    "remoteCache": {
        "enabled": false
    }
}
